#!/usr/bin/env python3
"""Launcher for `adc-crt` (Apple Studio Display 17" CRT control).

`make install` replaces the LIBDIR placeholder below with the directory that holds the
adc_crt package. Left unsubstituted, the launcher runs the package from the source tree.
"""

import os
import sys

LIBDIR = "@LIBDIR@"

# Spelled in two pieces so the install-time substitution cannot rewrite this comparison too.
_PLACEHOLDER = "@" "LIBDIR@"

if LIBDIR == _PLACEHOLDER:
    LIBDIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir)

sys.path.insert(0, os.path.abspath(LIBDIR))

from adc_crt.cli import main  # noqa: E402

sys.exit(main())
